# Telegram token (from @BotFather on Telegram)
TELEGRAM_TOKEN=

# ID of the Telegram channel where daily cases are posted (optional)
# Get this by adding @userinfobot to your channel and forwarding a message
TELEGRAM_CHANNEL_ID=

# Discord bot token (from Discord Developer Portal)
DISCORD_TOKEN=

# Discord application client ID (from Developer Portal > General Information)
DISCORD_CLIENT_ID=

# Discord guild ID for command registration during development (optional)
# Leave empty to register commands globally (slower, up to 1 hour)
DISCORD_GUILD_ID=

# Discord channel ID for daily puzzle auto-posts (optional)
DISCORD_DAILY_CHANNEL_ID=

# Absolute or relative path to the SQLite database file
# Defaults to ./data/players.db if not set
DB_PATH=./data/players.db

# Path to cases.json relative to the bot/ directory
# Defaults to ../data/cases.json (same repo, bot/ subfolder layout)
CASES_JSON_PATH=../data/cases.json
